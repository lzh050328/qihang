<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lzh.mapper.UserMapper">
    <select id="findByUsername">
        select user.* , role.label as roleLabel
        from user
        left outer join role on user.role_id = role.id
        where username = #{username}
    </select>
    <select id="findByPage" resultType="com.lzh.pojo.User" >
        select user.* ,dept.name as deptName,role.name as roleName
        from user
        left outer join dept on user.dept_id = dept.id
        left outer join role on user.role_id = role.id
        <where>
            <if test="userDto.name != null and userDto.name != ''">
                AND user.name like concat('%', #{userDto.name}, '%')
            </if>

            <if test="userDto.status != null ">
                AND user.status = #{userDto.status}
            </if>

            <if test="userDto.phone != null and userDto.phone != ''">
                AND user.phone like concat('%', #{userDto.phone}, '%')
            </if>

            <if test="userDto.deptId != null ">
                AND user.dept_id = #{userDto.deptId}
            </if>
        </where>

    </select>
    <select id="findByLabel" resultType="com.lzh.pojo.User">


        select user.*
        from user
        left outer join role on user.role_id = role.id
        <where>
            <if test="label != null and label != ''">
                <!-- 改：前端可能传角色标识(sales_manager)也可能传角色名称(销售经理)，两种都支持 -->
                AND user.role_id in (select role.id from role
                                     where role.label like concat('%', #{label}, '%')
                                        or role.name like concat('%', #{label}, '%'))
            </if>
        </where>




    </select>

    <select id="findByDeptId" resultType="com.lzh.pojo.User">
        select user.*,
        dept.name as deptName,
        role.name as roleName
        from user
        left outer join dept on user.dept_id = dept.id
        left outer join role on user.role_id = role.id
        <where>
            <if test="deptId != null">
                AND user.dept_id = #{deptId}
            </if>
        </where>
    </select>

</mapper>
